{
  "name": "everest-desktop",
  "version": "0.1.0",
  "author": "Everest Team <contact@everest-app.com>",
  "description": "Everest API Testing Platform",
  "repository": {
    "type": "git",
    "url": "https://github.com/Everest-App/Everest.git"
  },
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "wait-on http://localhost:5173 && tsc -p tsconfig.main.json && electron .",
    "build:renderer": "vite build",
    "build:main": "node esbuild.main.config.mjs",
    "build:copy-assets": "node scripts/copy-assets.mjs",
    "build:clean": "node scripts/clean.mjs",
    "build": "npm run build:clean && npm run build:renderer && npm run build:main && npm run build:copy-assets",
    "package": "npm run build && electron-builder --mac --win --linux --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "lint": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "test:bdd": "TS_NODE_PROJECT=tsconfig.test.json cucumber-js"
  },
  "dependencies": {
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@everest/core": "*",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/vazirmatn": "5.3.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "axios": "^1.17.0",
    "concurrently": "^10.0.3",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "terser": "^5.48.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.0.10",
    "ws": "^8.21.0",
    "uuid": "^14.0.0",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.everest.app",
    "productName": "Everest",
    "electronLanguages": ["en-US"],
    "electronVersion": "42.4.0",
    "asar": true,
    "compression": "maximum",
    "removePackageScripts": true,
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!dist/**/*.d.ts",
      "!dist/**/*.d.ts.map",
      "!dist/**/*.test.*",
      "!dist/**/*.spec.*",
      "!dist/**/__tests__/**",
      "!dist/builder-effective-config.yaml",
      "!dist/mac*",
      "!dist/win*",
      "!dist/*.dmg",
      "!dist/*.exe",
      "!dist/*.blockmap",
      "!**/node_modules/*/{CHANGELOG,README,LICENSE,license,changelog,readme}*",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}/**",
      "!**/node_modules/**/*.{md,ts,map,d.ts}",
      "!**/node_modules/.cache/**",
      "!**/node_modules/sql.js/dist/sql-asm*",
      "!**/node_modules/sql.js/dist/worker*",
      "!**/node_modules/sql.js/dist/*debug*"
    ],
    "extraResources": [
      {
        "from": "../../node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "resources/icon.png"
    },
    "deb": {
      "maintainer": "Everest Team <contact@everest-app.com>"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
